# =================================================================
# ESAYAS ADAL LUXURY REAL ESTATE - PRODUCTION & DEPLOYMENT CONFIG
# =================================================================
# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in the values for your deployment environment (e.g. Render, Railway, Vercel).
# 3. DO NOT commit your real .env file with actual credentials to git.
# =================================================================

# -----------------------------------------------------------------
# 1. SERVER & APPLICATION ENVIRONMENT
# -----------------------------------------------------------------
NODE_ENV=production
PORT=3000
APP_URL=https://your-production-domain.com
SITE_NAME="ESAYAS ADAL"

# -----------------------------------------------------------------
# 2. ADMIN AUTHENTICATION (Access to /admin)
# -----------------------------------------------------------------
# Set your production administrator email and strong password:
ADMIN_EMAIL=admin@esayas.com
ADMIN_PASSWORD=change-to-a-strong-secure-password
ADMIN_NAME="Esayas Adal"

# Generate a strong 64-character random string for signing admin JWT tokens:
AUTH_SECRET=generate-a-secure-random-64-character-secret-key

# -----------------------------------------------------------------
# 3. SUPABASE (DATABASE & MEDIA STORAGE)
# -----------------------------------------------------------------
# Found in your Supabase Project Settings -> API:
SUPABASE_URL=https://your-project-id.supabase.co

# Use your Supabase Service Role (Secret) key for backend operations:
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Public/Anon key:
SUPABASE_ANON_KEY=your-supabase-anon-key

# Direct PostgreSQL Connection URL (Found in Database Settings -> Connection string -> URI):
DATABASE_URL="postgresql://postgres:[YOUR-DATABASE-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres"

# Optional explicit DB connection parameters (used if DATABASE_URL is not set):
DB_HOST=db.your-project-id.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-database-password

# -----------------------------------------------------------------
# 4. GOOGLE GEMINI AI (PROPERTY ASSISTANT)
# -----------------------------------------------------------------
# Get your Gemini API key from https://aistudio.google.com:
GEMINI_API_KEY=your-google-gemini-api-key

# -----------------------------------------------------------------
# 5. EMAIL NOTIFICATIONS (SMTP)
# -----------------------------------------------------------------
# Used to send viewing and inquiry notification emails:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
CONTACT_EMAIL=info@esayas.com

# -----------------------------------------------------------------
# 6. CLIENT & DEVELOPMENT OPTIONS
# -----------------------------------------------------------------
DISABLE_HMR=false
